# ---- LLM (the writer agent and the claim checker). Primary is OpenAI-compatible (Groq by default).
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_MAX_TOKENS=8000
LLM_TIMEOUT=180

# ---- Optional fallback LLM (generic OpenAI-compatible). Use if primary hits quota/429/exhaustion/5xx.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# ---- Optional Anthropic key: enables the Anthropic writer + native web search, and CHECKER_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# ---- Claim checker: "anthropic" (default when ANTHROPIC_API_KEY is set) or "groq".
CHECKER_PROVIDER=
CHECKER_MODEL=

# ---- Web search: Tavily (recommended, free tier) or DuckDuckGo (no key needed, rate-limited).
TAVILY_API_KEY=

# ---- Telegram research digest (optional; bot token + chat id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Local storage (SQLite) for tenants, brains, packages and decisions.
DB_PATH=agent_team.db
